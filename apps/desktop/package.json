{
  "name": "sorttie-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first Windows file activity and safe organization client",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json && vite build --config vite.preload.config.mts",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:ui": "npm run build && playwright test --config=playwright.config.ts",
    "test:all": "npm run test && npm run test:ui",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
